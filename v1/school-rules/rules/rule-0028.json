      "order": 12,
      "articles": [
        {
          "id": "rule-0028-article-0014",
          "label": "第6条",
          "body": "第6条 委員会の事務は、第2条に掲げる任務を遂行するために、関係する係等の協力を得て、<br>総務課総務·企画係において処理する。",
          "notes": null,
          "relatedIds": null
        }
      ]
    },
    {
      "id": "rule-0028-section-13",
      "title": "(雑則)",
      "order": 13,
      "articles": [
